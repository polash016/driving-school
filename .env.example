# Local dev infrastructure (docker compose -f docker-compose.dev.yml up -d)
DATABASE_URL="postgresql://teoripro:teoripro@localhost:5544/teoripro"
REDIS_URL="redis://localhost:6399"
# Integration tests (vitest) run against a separate database
TEST_DATABASE_URL="postgresql://teoripro:teoripro@localhost:5544/teoripro_test"

# Auth (spec-03) — AUTH_SECRET signs the session JWT and derives the TOTP encryption key.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
# Required when not running behind a known host (self-hosted deployments)
AUTH_TRUST_HOST="true"
# Absolute base URL used in emailed links (verification, password reset, invites)
APP_BASE_URL="http://localhost:3000"

# Mail (spec-03). "smtp" = nodemailer transport, "capture" = in-memory sink (tests/CI).
MAIL_TRANSPORT="smtp"
SMTP_URL="smtp://localhost:1025"
EMAIL_FROM="TeoriPro <no-reply@demo.teoripro.no>"

# AI gateway (OmniRoute) — optional until spec-05/06
OMNIROUTE_BASE_URL=""
OMNIROUTE_API_KEY=""

# Background translation worker (spec-19) — `pnpm i18n:worker`, or the teoripro-i18n-worker pm2 app
I18N_WORKER_POLL_MS=5000
# The i18n worker runs translationParallelSlots batches at once; the default pool (CPUs*2+1) is too
# small for 3 slots on a 2-vCPU host. Give the worker its own: ?connection_limit=12&pool_timeout=20
# DATABASE_URL="postgresql://teoripro:teoripro@localhost:5544/teoripro?connection_limit=12&pool_timeout=20"
