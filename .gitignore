# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template: it lists required variables and holds no secrets
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# testing artifacts
/test-results/
/playwright-report/

# Uploaded question images (spec-06). Deliberately outside `public/`: these bytes are served only
# through the authenticated /api/images/[id] route, never as static files. Back this directory up
# alongside Postgres — the rows and the bytes are one dataset (spec-14).
/storage/

# Source material for the sign registry: a 34 MB third-party theory book and its chapter exports.
# `pnpm signs:extract` reads it, and its OUTPUT (public/signs/ + prisma/data/signs.json) is what
# gets committed. The book itself is not ours to redistribute.
/traffic_rules/

# superpowers brainstorming sessions
.superpowers/
